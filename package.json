{
  "name": "study-manager",
  "version": "0.1.0",
  "description": "Turn course material into a study guide, flashcards, adaptive quizzes, a tutor and a study plan, powered by Claude.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "dev:demo": "cross-env STUDY_MANAGER_DEMO=1 npm run dev",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sampurna01/Study-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/Sampurna01/Study-Manager/issues"
  },
  "homepage": "https://github.com/Sampurna01/Study-Manager#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "katex": "^0.16.47",
    "multer": "^2.5.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
