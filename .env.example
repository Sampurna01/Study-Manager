# Copy this file to ".env" to change settings. Everything here is optional.

# Which AI to use: "ollama" (free, runs on your computer — the default) or "anthropic" (Claude, paid API).
AI_PROVIDER=ollama

# Ollama model. Download it first with:  ollama pull <model>
# gemma3:4b works on any Apple-silicon Mac. With 16 GB+ of memory, gemma3:12b gives better results.
OLLAMA_MODEL=gemma3:4b

# How much text the local model may read at once (tokens). Raise for long courses if you have lots of memory.
# OLLAMA_MAX_CONTEXT=32768

# Only needed when AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
